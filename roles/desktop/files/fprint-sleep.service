[Unit]
Description=Stop fprintd before sleep so no fingerprint scan spans a suspend
# A verify still running when the laptop sleeps (Enter on the lock screen,
# then closing the lid) does not survive resume on the Synaptics 06cb:0106:
# the scan never completes, the claim is not released, and the sensor stays
# unusable until fprintd restarts. fprintd-warm.service starts a fresh daemon
# right after resume.
Before=sleep.target

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl stop fprintd.service

[Install]
WantedBy=sleep.target
